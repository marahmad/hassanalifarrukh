# AI & Audio APIs
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Database (Supabase PostgreSQL; falls back to local SQLite if empty)
DATABASE_URL=

# Google Sign-In (OAuth 2.0 + 1-Tap — Required for Web Chat Login)
# 1. Open https://console.cloud.google.com/apis/credentials (under the project's Google account)
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized JavaScript origins: http://localhost:8080 (and https://your-domain.com)
# 4. Add Authorized redirect URIs: http://localhost:8080/api/auth/google/callback (and https://your-domain.com/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session & Bridge Security Secrets (use strong random strings in production)
ADMIN_PASSWORD=change_this_admin_password
ADMIN_SESSION_SECRET=change_this_random_admin_secret
USER_SESSION_SECRET=change_this_random_user_session_secret
WHATSAPP_BRIDGE_SECRET=change_this_random_bridge_secret

# Meta WhatsApp Cloud API credentials (Optional — for future WhatsApp Cloud API)
WHATSAPP_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Admin & Pricing Configuration
ADMIN_PHONE_NUMBER=923001234567
FREE_TRIAL_QUESTIONS=3
MONTHLY_SUBSCRIPTION_PKR=1000
ACCOUNT_TITLE=Account Holder Name
EASYPAISA_NUMBER=03XXXXXXXXX
ALLIED_BANK_ACCOUNT=00000000000000000000
RAAST_ID_NUMBER=03XXXXXXXXX
